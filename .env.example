# Server-side only. Never expose these keys as NEXT_PUBLIC_*.
GEMINI_API_KEY=

# Text/multimodal analysis and scene planning.
GEMINI_VISION_MODEL=gemini-3.6-flash
GEMINI_SCENE_MODEL=gemini-3.6-flash
GEMINI_PROMPT_MODEL=gemini-3.6-flash

# Native image generation for complete storyboard frames.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
